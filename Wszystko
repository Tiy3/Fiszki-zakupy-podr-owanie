                    ...SHOPPING_SENTENCES.map((s, idx) => ({ id: idx + 41, pl: s.pl, en: s.en, origin: 'Zakupy' }))
                ]
            }
        };

        const LEGACY_STORAGE_KEY = 'fiszki_travel_40_v1';
        const MULTI_STORAGE_KEY = 'fiszki_multicat_v2';

        /**
         * Global Multi-Category Application State
         * Each category holds its own completely isolated learning state, weights, queue, pause flag & active card.
         */
        let appState = {
            activeCategory: 'travel',
            listFilter: 'all',
            categories: {
                travel: null,
                shopping: null,
                combined: null
            }
        };

        /**
         * Helper to get the currently active category's isolated state object
         */
        function getActiveCatState() {
            return appState.categories[appState.activeCategory];
        }

        /**
         * Creates default card metadata for a given category key
         */
        function createInitialCardsForCategory(catKey) {
            return CATEGORIES[catKey].sentences.map(item => ({
                id: item.id,
                pl: item.pl,
                en: item.en,
                origin: item.origin,
                status: 'new',       // 'new' | 'hard' | 'unsure' | 'known'
                masteryLevel: 0,     // 0 to 5
                weight: 4.0,         // Selection priority weight
                dueStep: 0,          // Earliest globalStep for reappearance
                attempts: 0,
                hardCount: 0,
                unsureCount: 0,
                knownCount: 0
            }));
        }

        /**
         * Creates a fresh isolated state object for a category
         */
        function createInitialCategoryState(catKey) {
            return {
                cards: createInitialCardsForCategory(catKey),
                globalStep: 0,
                sessionReviews: 0,
                direction: 'pl-en',
                currentCardId: null,
                currentCardFrontLang: 'pl',
                isFlipped: false,
                isPaused: false,
                lastSavedAt: null
            };
        }

        /**
         * Validates and normalizes a loaded category state object
         */
        function hydrateCategoryState(catKey, rawCatState) {
            const expectedLen = CATEGORIES[catKey].sentences.length;
            if (rawCatState && Array.isArray(rawCatState.cards) && rawCatState.cards.length === expectedLen) {
                // Ensure origin tags remain intact
                const defaultSentences = CATEGORIES[catKey].sentences;
                const mergedCards = rawCatState.cards.map((c, i) => ({
                    ...c,
                    pl: defaultSentences[i].pl,
                    en: defaultSentences[i].en,
                    origin: defaultSentences[i].origin
                }));
                return {
                    cards: mergedCards,
                    globalStep: rawCatState.globalStep || 0,
                    sessionReviews: 0, // Reset live session counter on page reload
                    direction: rawCatState.direction || 'pl-en',
                    currentCardId: rawCatState.currentCardId || null,
                    currentCardFrontLang: rawCatState.currentCardFrontLang || 'pl',
                    isFlipped: Boolean(rawCatState.isFlipped),
                    isPaused: Boolean(rawCatState.isPaused),
                    lastSavedAt: rawCatState.lastSavedAt || null
                };
            }
            return createInitialCategoryState(catKey);
        }

        /**
         * Load multi-category progress from localStorage (with seamless migration from v1 single-category storage)
         */
        function loadAllState() {
            appState.categories.travel = createInitialCategoryState('travel');
            appState.categories.shopping = createInitialCategoryState('shopping');
            appState.categories.combined = createInitialCategoryState('combined');

            try {
                const savedMulti = localStorage.getItem(MULTI_STORAGE_KEY);
                if (savedMulti) {
                    const parsed = JSON.parse(savedMulti);
                    if (parsed && parsed.categories) {
                        appState.activeCategory = CATEGORIES[parsed.activeCategory] ? parsed.activeCategory : 'travel';
                        appState.categories.travel = hydrateCategoryState('travel', parsed.categories.travel);
                        appState.categories.shopping = hydrateCategoryState('shopping', parsed.categories.shopping);
                        appState.categories.combined = hydrateCategoryState('combined', parsed.categories.combined);
                        const active = getActiveCatState();
                        return active.globalStep > 0 || active.currentCardId !== null;
                    }
                }

                // Fallback migration from v1 single-category storage ("travel")
                const legacySaved = localStorage.getItem(LEGACY_STORAGE_KEY);
                if (legacySaved) {
                    const parsedLegacy = JSON.parse(legacySaved);
                    appState.categories.travel = hydrateCategoryState('travel', parsedLegacy);
                    saveAllState();
                    const active = getActiveCatState();
                    return active.globalStep > 0 || active.currentCardId !== null;
                }
            } catch (e) {
                console.warn('Nie udało się odczytać zapisanego postępu:', e);
            }
            return false;
        }

        /**
         * Persist all 3 independent category states to localStorage
         */
        function saveAllState() {
            try {
                const active = getActiveCatState();
                active.lastSavedAt = new Date().toISOString();

                const payload = {
                    version: 2,
                    activeCategory: appState.activeCategory,
                    categories: {
                        travel: { ...appState.categories.travel, sessionReviews: undefined },
                        shopping: { ...appState.categories.shopping, sessionReviews: undefined },
                        combined: { ...appState.categories.combined, sessionReviews: undefined }
                    }
                };
                localStorage.setItem(MULTI_STORAGE_KEY, JSON.stringify(payload));
            } catch (e) {
                console.warn('Nie udało się zapisać postępu:', e);
            }
        }

        /**
         * Switch between the 3 independent categories
         */
        function switchCategory(newCatKey) {
            if (!CATEGORIES[newCatKey] || appState.activeCategory === newCatKey) return;

            appState.activeCategory = newCatKey;
            appState.listFilter = 'all';
            cancelReset();
            saveAllState();

            const state = getActiveCatState();
            document.getElementById('directionSelect').value = state.direction;

            updateCategoryTabsUI();
            updateDashboardStats();

            const statsView = document.getElementById('statsView');
            const isStatsOpen = !statsView.classList.contains('hidden');

            if (isStatsOpen) {
                setListFilter('all');
                renderPhrasesTable();
                if (!state.currentCardId) {
                    selectNextCard();
                }
            } else {
                if (state.isPaused) {
                    if (!state.currentCardId) {
                        selectNextCard();
                    }
                    pauseStudy();
                } else {
                    document.getElementById('pausedView').classList.add('hidden');
                    document.getElementById('pausedView').classList.remove('flex');
                    document.getElementById('studyView').classList.remove('hidden');

                    if (state.currentCardId) {
                        restoreCardUIState();
                    } else {
                        selectNextCard();
                    }
                }
            }

            showToast(`Przełączono na kategorię: ${CATEGORIES[newCatKey].name}`);
        }

        /**
         * Updates the visual styling & progress indicators on all 3 category tabs
         */
        function updateCategoryTabsUI() {
            ['travel', 'shopping', 'combined'].forEach(catKey => {
                const catState = appState.categories[catKey];
                const total = catState.cards.length;
                const knownCount = catState.cards.filter(c => c.status === 'known').length;
                const totalMasteryPoints = catState.cards.reduce((sum, c) => sum + c.masteryLevel, 0);
                const masteryPercent = Math.round((totalMasteryPoints / (total * 5)) * 100);

                const tabBtn = document.getElementById(`catTab-${catKey}`);
                const badgeEl = document.getElementById(`catBadge-${catKey}`);
                const knownEl = document.getElementById(`catKnown-${catKey}`);
                const barEl = document.getElementById(`catBar-${catKey}`);

                badgeEl.textContent = `${masteryPercent}%`;
                knownEl.textContent = `Opanowane: ${knownCount}/${total}`;
                barEl.style.width = `${masteryPercent}%`;

                if (appState.activeCategory === catKey) {
                    tabBtn.className = 'category-tab text-left p-2.5 rounded-xl border transition-all cursor-pointer flex flex-col justify-between gap-1.5 bg-white border-indigo-500 ring-2 ring-indigo-500/20 shadow-xs';
                    badgeEl.className = 'text-[11px] font-bold px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 shrink-0';
                } else {
                    tabBtn.className = 'category-tab text-left p-2.5 rounded-xl border transition-all cursor-pointer flex flex-col justify-between gap-1.5 bg-white/70 hover:bg-white border-slate-200';
                    badgeEl.className = 'text-[11px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 shrink-0';
                }
            });
        }

        /**
         * ADAPTIVE SPACED REPETITION & PRIORITY ALGORITHM (Runs independently per category)
         */
        function selectNextCard() {
            const state = getActiveCatState();
            const step = state.globalStep;
            
            let pool = state.cards.filter(c => c.id !== state.currentCardId);
            if (pool.length === 0) pool = [...state.cards];

            let dueCards = pool.filter(c => c.dueStep <= step);

            if (dueCards.length === 0) {
                pool.sort((a, b) => a.dueStep - b.dueStep);
                dueCards = pool.slice(0, 6);
            }

            const scoredCards = dueCards.map(card => {
                const overdueSteps = Math.max(0, step - card.dueStep);
                const overdueBoost = 1 + (overdueSteps * 0.12);
                const troubleFactor = 1 + (card.hardCount * 0.35);
                const finalScore = card.weight * overdueBoost * troubleFactor;
                return { card, score: finalScore };
            });

            const totalScore = scoredCards.reduce((sum, item) => sum + item.score, 0);
            let randomThreshold = Math.random() * totalScore;
            let chosen = scoredCards[0].card;

            for (const item of scoredCards) {
                randomThreshold -= item.score;
                if (randomThreshold <= 0) {
                    chosen = item.card;
                    break;
                }
            }

            state.currentCardId = chosen.id;

            if (state.direction === 'pl-en') {
                state.currentCardFrontLang = 'pl';
            } else if (state.direction === 'en-pl') {
                state.currentCardFrontLang = 'en';
            } else {
                state.currentCardFrontLang = Math.random() < 0.5 ? 'pl' : 'en';
            }

            saveAllState();
            renderCurrentCard();
        }

        /**
         * Updates card metrics after user rates their knowledge in the active category
         */
        function rateCard(rating) {
            const state = getActiveCatState();
            const card = state.cards.find(c => c.id === state.currentCardId);
            if (!card) return;

            state.globalStep += 1;
            state.sessionReviews += 1;
            card.attempts += 1;

            if (rating === 'hard') {
                card.status = 'hard';
                card.hardCount += 1;
                card.masteryLevel = 0;
                card.weight = Math.min(20, 11 + card.hardCount * 1.5);
                card.dueStep = state.globalStep + 2 + Math.floor(Math.random() * 2);
            } 
            else if (rating === 'unsure') {
                card.status = 'unsure';
                card.unsureCount += 1;
                card.masteryLevel = Math.max(0, card.masteryLevel - 1);
                card.weight = Math.min(14, 6.5 + card.hardCount * 0.8);
                card.dueStep = state.globalStep + 5 + Math.floor(Math.random() * 2);
            } 
            else if (rating === 'known') {
                card.status = 'known';
                card.knownCount += 1;
                card.masteryLevel = Math.min(5, card.masteryLevel + 1);

                const intervalMap = { 1: 9, 2: 15, 3: 22, 4: 30, 5: 38 };
                const baseInterval = intervalMap[card.masteryLevel] || 10;
                const jitter = Math.floor(Math.random() * 4);
                card.dueStep = state.globalStep + baseInterval + jitter;
                card.weight = Math.max(0.45, 2.4 - (card.masteryLevel * 0.4));
            }

            saveAllState();
            updateDashboardStats();

            const flashcardInner = document.getElementById('flashcardInner');
            if (state.isFlipped) {
                state.isFlipped = false;
                flashcardInner.classList.remove('rotate-y-180');
                document.getElementById('ratingButtonsArea').classList.add('hidden');
                document.getElementById('ratingButtonsArea').classList.remove('grid');
                document.getElementById('revealPromptArea').classList.remove('hidden');
                
                setTimeout(() => {
                    selectNextCard();
                }, 180);
            } else {
                selectNextCard();
            }
        }

        /**
         * Renders the active card onto the DOM
         */
        function renderCurrentCard() {
            const state = getActiveCatState();
            const totalInCat = state.cards.length;
            const card = state.cards.find(c => c.id === state.currentCardId);
            if (!card) return;

            const isPlFront = state.currentCardFrontLang === 'pl';
            const frontText = isPlFront ? card.pl : card.en;
            const backText = isPlFront ? card.en : card.pl;

            document.getElementById('cardNumberBadge').textContent = `#${card.id} / ${totalInCat}`;
            document.getElementById('frontLangLabel').textContent = isPlFront ? '🇵🇱 Polski' : '🇬🇧 Angielski';
            document.getElementById('backLangLabel').textContent = isPlFront ? '🇬🇧 Angielski' : '🇵🇱 Polski';

            // Show origin badge when in the combined 80-card category
            const originBadge = document.getElementById('cardOriginBadge');
            if (appState.activeCategory === 'combined') {
                originBadge.textContent = card.origin === 'Podróże' ? '✈️ Podróże' : '🛍️ Zakupy';
                originBadge.classList.remove('hidden');
            } else {
                originBadge.classList.add('hidden');
            }
            
            document.getElementById('frontText').textContent = frontText;
            document.getElementById('backText').textContent = backText;
            document.getElementById('backReferenceText').textContent = frontText;

            const frontSpeakBtn = document.getElementById('frontSpeakBtn');
            if (!isPlFront) {
                frontSpeakBtn.classList.remove('hidden');
                frontSpeakBtn.classList.add('flex');
            } else {
                frontSpeakBtn.classList.add('hidden');
                frontSpeakBtn.classList.remove('flex');
            }

            const badge = document.getElementById('cardReasonBadge');
            if (card.status === 'new') {
                badge.textContent = 'Nowy zwrot';
                badge.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700';
            } else if (card.status === 'hard') {
                badge.textContent = 'Priorytet: Sprawiało trudność';
                badge.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700';
            } else if (card.status === 'unsure') {
                badge.textContent = 'Powtórka: Niepewne';
                badge.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700';
            } else {
                badge.textContent = 'Przypomnienie (Utrwalanie)';
                badge.className = 'text-xs font-semibold px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700';
            }

            const nextLevel = Math.min(5, card.masteryLevel + 1);
            const nextIntervalMap = { 1: 9, 2: 15, 3: 22, 4: 30, 5: 38 };
            document.getElementById('hintKnown').textContent = `Przypomnienie za ~${nextIntervalMap[nextLevel]} fiszek`;

            document.getElementById('cardHistoryInfo').textContent = 
                `Próby: ${card.attempts} • Poziom utrwalenia: ${card.masteryLevel}/5`;
        }

        /**
         * Flips the flashcard between front and back
         */
        function flipCard() {
            const state = getActiveCatState();
            const flashcardInner = document.getElementById('flashcardInner');
            const revealPromptArea = document.getElementById('revealPromptArea');
            const ratingButtonsArea = document.getElementById('ratingButtonsArea');

            state.isFlipped = !state.isFlipped;

            if (state.isFlipped) {
                flashcardInner.classList.add('rotate-y-180');
                revealPromptArea.classList.add('hidden');
                ratingButtonsArea.classList.remove('hidden');
                ratingButtonsArea.classList.add('grid');
            } else {
                flashcardInner.classList.remove('rotate-y-180');
                ratingButtonsArea.classList.add('hidden');
                ratingButtonsArea.classList.remove('grid');
                revealPromptArea.classList.remove('hidden');
            }

            saveAllState();
        }

        /**
         * Text-to-Speech (Web Speech API) for English pronunciation
         */
        function speakEnglish() {
            const state = getActiveCatState();
            const card = state.cards.find(c => c.id === state.currentCardId);
            if (!card) return;

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(card.en);
                utterance.lang = 'en-GB';
                utterance.rate = 0.95;
                window.speechSynthesis.speak(utterance);
            } else {
                showToast('Twoja przeglądarka nie obsługuje syntezatora mowy.');
            }
        }

        /**
         * Updates top dashboard counters, category tabs, and global progress bar
         */
        function updateDashboardStats() {
            const state = getActiveCatState();
            const total = state.cards.length;
            const knownCards = state.cards.filter(c => c.status === 'known').length;
            const hardOrUnsure = state.cards.filter(c => c.status === 'hard' || c.status === 'unsure').length;
            
            const totalMasteryPoints = state.cards.reduce((sum, c) => sum + c.masteryLevel, 0);
            const masteryPercent = Math.round((totalMasteryPoints / (total * 5)) * 100);

            document.getElementById('statMasteryPercent').textContent = `${masteryPercent}%`;
            document.getElementById('statKnownCount').textContent = `${knownCards} / ${total}`;
            document.getElementById('statHardCount').textContent = `${hardOrUnsure}`;
            document.getElementById('statSessionCount').textContent = `${state.sessionReviews}`;
            document.getElementById('globalProgressBar').style.width = `${masteryPercent}%`;

            updateCategoryTabsUI();
        }

        /**
         * Direction change handler for active category
         */
        function changeDirection(newDir) {
            const state = getActiveCatState();
            state.direction = newDir;
            saveAllState();
            if (state.isFlipped) {
                flipCard();
            }
            selectNextCard();
        }

        /**
         * Toggles between Flashcard Study View and Stats/All Phrases List View
         */
        function toggleStatsView() {
            const state = getActiveCatState();
            const studyView = document.getElementById('studyView');
            const pausedView = document.getElementById('pausedView');
            const statsView = document.getElementById('statsView');
            const btnText = document.getElementById('toggleStatsText');

            const isStatsHidden = statsView.classList.contains('hidden');
            if (isStatsHidden) {
                studyView.classList.add('hidden');
                pausedView.classList.add('hidden');
                pausedView.classList.remove('flex');
                statsView.classList.remove('hidden');
                statsView.classList.add('flex');
                btnText.textContent = 'Wróć do fiszek';
                renderPhrasesTable();
            } else {
                statsView.classList.add('hidden');
                statsView.classList.remove('flex');
                if (state.isPaused) {
                    pausedView.classList.remove('hidden');
                    pausedView.classList.add('flex');
                } else {
                    studyView.classList.remove('hidden');
                }
                btnText.textContent = 'Statystyki i lista';
                cancelReset();
            }
        }

        /**
         * Pause Study Session for Active Category
         */
        function pauseStudy() {
            const state = getActiveCatState();
            state.isPaused = true;
            saveAllState();

            const studyView = document.getElementById('studyView');
            const statsView = document.getElementById('statsView');
            const pausedView = document.getElementById('pausedView');
            const btnText = document.getElementById('toggleStatsText');

            studyView.classList.add('hidden');
            statsView.classList.add('hidden');
            statsView.classList.remove('flex');
            btnText.textContent = 'Statystyki i lista';

            pausedView.classList.remove('hidden');
            pausedView.classList.add('flex');

            const total = state.cards.length;
            const totalMasteryPoints = state.cards.reduce((sum, c) => sum + c.masteryLevel, 0);
            const masteryPercent = Math.round((totalMasteryPoints / (total * 5)) * 100);

            document.getElementById('pausedCategoryName').textContent = CATEGORIES[appState.activeCategory].name;
            document.getElementById('pausedCardInfo').textContent = `#${state.currentCardId || 1} / ${total}`;
            document.getElementById('pausedSessionReviews').textContent = `${state.sessionReviews}`;
            document.getElementById('pausedMasteryPercent').textContent = `${masteryPercent}%`;
            document.getElementById('pausedTimestamp').textContent = formatTimestamp(state.lastSavedAt);
        }

        /**
         * Resume Study Session right where the user left off in the active category
         */
        function resumeStudy() {
            const state = getActiveCatState();
            state.isPaused = false;
            saveAllState();

            const pausedView = document.getElementById('pausedView');
            const studyView = document.getElementById('studyView');

            pausedView.classList.add('hidden');
            pausedView.classList.remove('flex');
            studyView.classList.remove('hidden');

            restoreCardUIState();
            showToast(`Wznowiono (${CATEGORIES[appState.activeCategory].shortName}) od fiszki #${state.currentCardId}`);
        }

        /**
         * Restores visual flip state and buttons for the current card
         */
        function restoreCardUIState() {
            const state = getActiveCatState();
            renderCurrentCard();
            const flashcardInner = document.getElementById('flashcardInner');
            const revealPromptArea = document.getElementById('revealPromptArea');
            const ratingButtonsArea = document.getElementById('ratingButtonsArea');

            if (state.isFlipped) {
                flashcardInner.classList.add('rotate-y-180');
                revealPromptArea.classList.add('hidden');
                ratingButtonsArea.classList.remove('hidden');
                ratingButtonsArea.classList.add('grid');
            } else {
                flashcardInner.classList.remove('rotate-y-180');
                ratingButtonsArea.classList.add('hidden');
                ratingButtonsArea.classList.remove('grid');
                revealPromptArea.classList.remove('hidden');
            }
        }

        /**
         * Formats ISO timestamp into readable Polish time/date string
         */
        function formatTimestamp(isoString) {
            if (!isoString) return 'Teraz';
            try {
                const date = new Date(isoString);
                return date.toLocaleString('pl-PL', {
                    day: '2-digit',
                    month: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            } catch (e) {
                return 'Zapisano';
            }
        }

        function dismissWelcomeBanner() {
            const banner = document.getElementById('welcomeBackBanner');
            banner.classList.add('hidden');
            banner.classList.remove('flex');
        }

        /**
         * Backup & Restore Modal Controls
         */
        function openBackupModal() {
            const modal = document.getElementById('backupModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeBackupModal() {
            const modal = document.getElementById('backupModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.getElementById('importCodeInput').value = '';
        }

        function getSerializedBackup() {
            saveAllState();
            return JSON.stringify({
                version: 2,
                exportedAt: new Date().toISOString(),
                activeCategory: appState.activeCategory,
                categories: {
                    travel: appState.categories.travel,
                    shopping: appState.categories.shopping,
                    combined: appState.categories.combined
                }
            });
        }

        function downloadBackupFile() {
            try {
                const dataStr = getSerializedBackup();
                const blob = new Blob([dataStr], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                const datePart = new Date().toISOString().slice(0, 10);
                a.href = url;
                a.download = `fiszki_angielski_postep_${datePart}.json`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showToast('Pobrano plik z kopią zapasową!');
            } catch (e) {
                showToast('Błąd podczas tworzenia pliku kopii.');
            }
        }

        function copyBackupCode() {
            try {
                const raw = getSerializedBackup();
                // Encode UTF-8 string safely to Base64
                const encoded = btoa(unescape(encodeURIComponent(raw)));
                const tempInput = document.createElement('textarea');
                tempInput.value = encoded;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                showToast('Skopiowano kod postępu do schowka!');
            } catch (e) {
                showToast('Nie udało się skopiować kodu.');
            }
        }

        function applyImportedData(parsed) {
            if (!parsed) {
                showToast('Nieprawidłowy format danych kopii zapasowej.');
                return false;
            }

            // Support v2 multi-category backup
            if (parsed.version === 2 && parsed.categories) {
                appState.activeCategory = CATEGORIES[parsed.activeCategory] ? parsed.activeCategory : 'travel';
                appState.categories.travel = hydrateCategoryState('travel', parsed.categories.travel);
                appState.categories.shopping = hydrateCategoryState('shopping', parsed.categories.shopping);
                appState.categories.combined = hydrateCategoryState('combined', parsed.categories.combined);
            } 
            // Support v1 single-category backup (imports into 'travel')
            else if (Array.isArray(parsed.cards) && parsed.cards.length === 40) {
                appState.activeCategory = 'travel';
                appState.categories.travel = hydrateCategoryState('travel', parsed);
            } else {
                showToast('Nieprawidłowy format danych kopii zapasowej.');
                return false;
            }

            const state = getActiveCatState();
            state.isPaused = false;
            document.getElementById('directionSelect').value = state.direction;

            saveAllState();
            updateDashboardStats();
            renderPhrasesTable();

            document.getElementById('pausedView').classList.add('hidden');
            document.getElementById('pausedView').classList.remove('flex');
            document.getElementById('statsView').classList.add('hidden');
            document.getElementById('statsView').classList.remove('flex');
            document.getElementById('studyView').classList.remove('hidden');
            document.getElementById('toggleStatsText').textContent = 'Statystyki i lista';

            if (state.currentCardId) {
                restoreCardUIState();
            } else {
                selectNextCard();
            }

            closeBackupModal();
            showToast('Pomyślnie wczytano postęp wszystkich kategorii!');
            return true;
        }

        function handleBackupFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    applyImportedData(parsed);
                } catch (err) {
                    showToast('Błąd odczytu pliku JSON.');
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        function importFromCode() {
            const code = document.getElementById('importCodeInput').value.trim();
            if (!code) {
                showToast('Wklej najpierw kod postępu.');
                return;
            }
            try {
                const decoded = decodeURIComponent(escape(atob(code)));
                const parsed = JSON.parse(decoded);
                applyImportedData(parsed);
            } catch (e) {
                showToast('Nieprawidłowy kod postępu.');
            }
        }

        /**
         * Filters the phrases table in the Stats View
         */
        function setListFilter(filter) {
            appState.listFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.dataset.filter === filter) {
                    btn.className = 'filter-btn bg-slate-800 text-white text-xs font-semibold px-3 py-1.5 rounded-lg cursor-pointer';
                } else {
                    btn.className = 'filter-btn bg-slate-100 text-slate-600 hover:bg-slate-200 text-xs font-semibold px-3 py-1.5 rounded-lg cursor-pointer';
                }
            });
            renderPhrasesTable();
        }

        /**
         * Renders sentences and algorithmic weights/statuses for the currently active category
         */
        function renderPhrasesTable() {
            const state = getActiveCatState();
            const catMeta = CATEGORIES[appState.activeCategory];
            const total = state.cards.length;

            document.getElementById('statsViewTitle').textContent = 
                `Analiza postępów: ${catMeta.name} (${total} zdań)`;
            document.getElementById('filterAllBtn').textContent = `Wszystkie (${total})`;

            const tbody = document.getElementById('phrasesTableBody');
            tbody.innerHTML = '';

            const filtered = state.cards.filter(card => {
                if (appState.listFilter === 'all') return true;
                return card.status === appState.listFilter;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="py-8 text-center text-slate-400 text-sm">
                            Brak zwrotów w tej kategorii.
                        </td>
                    </tr>
                `;
                return;
            }

            filtered.forEach(card => {
                let statusBadge = '';
                if (card.status === 'new') {
                    statusBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">Nowe</span>';
                } else if (card.status === 'hard') {
                    statusBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-700">Nie umiem</span>';
                } else if (card.status === 'unsure') {
                    statusBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">Niepewne</span>';
                } else {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">Umiem (${card.masteryLevel}/5)</span>`;
                }

                let priorityLabel = 'Normalny';
                if (card.weight >= 9) priorityLabel = '<span class="text-rose-600 font-bold">Bardzo wysoki</span>';
                else if (card.weight >= 5) priorityLabel = '<span class="text-amber-600 font-semibold">Podwyższony</span>';
                else if (card.weight <= 1.2) priorityLabel = '<span class="text-emerald-600">Przypominający</span>';

                const originPill = appState.activeCategory === 'combined'
                    ? `<span class="inline-block mr-1.5 text-[10px] font-semibold px-1.5 py-0.5 rounded bg-purple-50 text-purple-700 border border-purple-100">${card.origin}</span>`
                    : '';

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition';
                tr.innerHTML = `
                    <td class="py-3 px-3.5 font-semibold text-slate-400 align-top">${card.id}</td>
                    <td class="py-3 px-3.5 align-top">
                        <p class="font-semibold text-slate-800">${originPill}${card.pl}</p>
                        <p class="text-indigo-700 font-medium mt-0.5">${card.en}</p>
                    </td>
                    <td class="py-3 px-3.5 align-top whitespace-nowrap">${statusBadge}</td>
                    <td class="py-3 px-3.5 align-top text-right whitespace-nowrap text-xs text-slate-500">
                        <div>Priorytet: ${priorityLabel}</div>
                        <div class="mt-0.5">Próby: ${card.attempts} (Błędy: ${card.hardCount})</div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        /**
         * Two-step progress reset without browser confirm()
         */
        function promptReset() {
            document.getElementById('resetStep1Btn').classList.add('hidden');
            document.getElementById('resetConfirmBox').classList.remove('hidden');
            document.getElementById('resetConfirmBox').classList.add('flex');
        }

        function cancelReset() {
            document.getElementById('resetConfirmBox').classList.add('hidden');
            document.getElementById('resetConfirmBox').classList.remove('flex');
            document.getElementById('resetStep1Btn').classList.remove('hidden');
        }

        function executeReset() {
            const activeKey = appState.activeCategory;
            appState.categories[activeKey] = createInitialCategoryState(activeKey);
            saveAllState();
            updateDashboardStats();
            renderPhrasesTable();
            cancelReset();
            selectNextCard();
            showToast(`Statystyki kategorii „${CATEGORIES[activeKey].name}” zostały wyzerowane.`);
        }

        /**
         * Displays a brief toast notification
         */
        function showToast(message) {
            const toast = document.getElementById('toastBanner');
            toast.textContent = message;
            toast.classList.remove('opacity-0');
            setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 2600);
        }

        /**
         * Keyboard Shortcuts Support
         * Space: Flip card
         * 1: Nie umiem | 2: Nie jestem pewien | 3: Umiem
         */
        document.addEventListener('keydown', (e) => {
            const state = getActiveCatState();
            const statsView = document.getElementById('statsView');
            const backupModal = document.getElementById('backupModal');
            if (!statsView.classList.contains('hidden')) return;
            if (!backupModal.classList.contains('hidden')) return;
            if (state.isPaused) return;
            if (document.activeElement && (document.activeElement.tagName === 'SELECT' || document.activeElement.tagName === 'INPUT')) return;

            if (e.code === 'Space') {
                e.preventDefault();
                flipCard();
            } else if (state.isFlipped) {
                if (e.key === '1') {
                    rateCard('hard');
                } else if (e.key === '2') {
                    rateCard('unsure');
                } else if (e.key === '3') {
                    rateCard('known');
                }
            }
        });

        // Initialize Application on Load
        window.addEventListener('DOMContentLoaded', () => {
            const hasSavedProgress = loadAllState();
            const state = getActiveCatState();
            document.getElementById('directionSelect').value = state.direction;
            updateDashboardStats();

            if (hasSavedProgress && state.currentCardId) {
                const banner = document.getElementById('welcomeBackBanner');
                banner.classList.remove('hidden');
                banner.classList.add('flex');
                document.getElementById('welcomeBackSubtext').textContent = 
                    `Kategoria: ${CATEGORIES[appState.activeCategory].name} • Fiszka #${state.currentCardId} • Ostatni zapis: ${formatTimestamp(state.lastSavedAt)}`;

                if (state.isPaused) {
                    pauseStudy();
                } else {
                    restoreCardUIState();
                }
            } else {
                selectNextCard();
            }
        });
    </script>
</body>
</html>
