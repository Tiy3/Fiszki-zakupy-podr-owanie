<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiszki Angielski - Inteligentny System Powtórek</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* 3D Card Flip Mechanics */
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }
        /* Subtle custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans selection:bg-indigo-100 selection:text-indigo-900">

    <!-- Top Navigation & Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-lg shadow-sm">
                    EN
                </div>
                <div>
                    <h1 class="font-bold text-slate-900 text-base sm:text-lg leading-tight">Fiszki Angielski</h1>
                    <p class="text-xs text-slate-500 hidden sm:block">Adaptacyjny algorytm powtórek • 3 kategorie</p>
                </div>
            </div>

            <!-- Mode & View Controls -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Direction Selector -->
                <select id="directionSelect" onchange="changeDirection(this.value)" title="Kierunek tłumaczenia"
                    class="text-xs sm:text-sm bg-slate-100 hover:bg-slate-200/70 text-slate-700 font-medium py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition cursor-pointer">
                    <option value="pl-en">🇵🇱 PL ➔ 🇬🇧 EN</option>
                    <option value="en-pl">🇬🇧 EN ➔ 🇵🇱 PL</option>
                    <option value="mixed">🔀 Tryb mieszany</option>
                </select>

                <!-- Pause Study Button -->
                <button onclick="pauseStudy()" id="pauseStudyBtn" title="Zapisz stan i zrób przerwę"
                    class="flex items-center gap-1.5 text-xs sm:text-sm bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold py-2 px-3.5 rounded-xl border border-amber-200 transition cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Zrób przerwę</span>
                </button>

                <!-- Backup / Restore Button -->
                <button onclick="openBackupModal()" title="Kopia zapasowa postępu (Zapisz / Wczytaj)"
                    class="flex items-center gap-1.5 text-xs sm:text-sm bg-slate-100 hover:bg-slate-200/80 text-slate-700 font-semibold py-2 px-3 rounded-xl border border-slate-200 transition cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                    </svg>
                    <span class="hidden md:inline">Kopia zapasowa</span>
                </button>

                <!-- Toggle Stats / List Modal Button -->
                <button onclick="toggleStatsView()" id="toggleStatsBtn"
                    class="flex items-center gap-1.5 text-xs sm:text-sm bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold py-2 px-3.5 rounded-xl border border-indigo-200 transition cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span id="toggleStatsText">Statystyki i lista</span>
                </button>
            </div>
        </div>

        <!-- Category Switcher Bar (Independent states & progress per category) -->
        <div class="bg-slate-50/90 border-t border-slate-200/80">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 py-2.5">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" id="categoryTabsContainer">
                    <!-- Category 1: Podróże i transport -->
                    <button type="button" onclick="switchCategory('travel')" id="catTab-travel"
                        class="category-tab text-left p-2.5 rounded-xl border transition-all cursor-pointer flex flex-col justify-between gap-1.5 bg-white border-indigo-500 ring-2 ring-indigo-500/20 shadow-xs">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs sm:text-sm font-bold text-slate-900 truncate">✈️ Podróże i transport</span>
                            <span id="catBadge-travel" class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 shrink-0">0%</span>
                        </div>
                        <div class="flex items-center justify-between text-[11px] text-slate-500">
                            <span>40 fiszek</span>
                            <span id="catKnown-travel">Opanowane: 0/40</span>
                        </div>
                        <div class="w-full bg-slate-100 h-1 rounded-full overflow-hidden">
                            <div id="catBar-travel" class="bg-indigo-600 h-1 transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </button>

                    <!-- Category 2: Zakupy i usługi -->
                    <button type="button" onclick="switchCategory('shopping')" id="catTab-shopping"
                        class="category-tab text-left p-2.5 rounded-xl border transition-all cursor-pointer flex flex-col justify-between gap-1.5 bg-white/70 hover:bg-white border-slate-200">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs sm:text-sm font-bold text-slate-800 truncate">🛍️ Zakupy i usługi</span>
                            <span id="catBadge-shopping" class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 shrink-0">0%</span>
                        </div>
                        <div class="flex items-center justify-between text-[11px] text-slate-500">
                            <span>40 fiszek</span>
                            <span id="catKnown-shopping">Opanowane: 0/40</span>
                        </div>
                        <div class="w-full bg-slate-100 h-1 rounded-full overflow-hidden">
                            <div id="catBar-shopping" class="bg-indigo-600 h-1 transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </button>

                    <!-- Category 3: Wszystkie (Połączone) -->
                    <button type="button" onclick="switchCategory('combined')" id="catTab-combined"
                        class="category-tab text-left p-2.5 rounded-xl border transition-all cursor-pointer flex flex-col justify-between gap-1.5 bg-white/70 hover:bg-white border-slate-200">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs sm:text-sm font-bold text-slate-800 truncate">📚 Wszystkie (Połączone)</span>
                            <span id="catBadge-combined" class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 shrink-0">0%</span>
                        </div>
                        <div class="flex items-center justify-between text-[11px] text-slate-500">
                            <span>80 fiszek</span>
                            <span id="catKnown-combined">Opanowane: 0/80</span>
                        </div>
                        <div class="w-full bg-slate-100 h-1 rounded-full overflow-hidden">
                            <div id="catBar-combined" class="bg-indigo-600 h-1 transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Global Mastery Progress Bar for Active Category -->
        <div class="w-full bg-slate-100 h-1.5">
            <div id="globalProgressBar" class="bg-gradient-to-r from-indigo-500 via-purple-500 to-emerald-500 h-1.5 transition-all duration-500" style="width: 0%"></div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-6 flex flex-col justify-between">

        <!-- Welcome Back Banner (Shown when resuming previous progress) -->
        <div id="welcomeBackBanner" class="hidden mb-4 bg-indigo-50 border border-indigo-200 text-indigo-900 px-4 py-3 rounded-2xl items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5 text-xs sm:text-sm">
                <span class="w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shrink-0">↻</span>
                <div>
                    <p class="font-semibold">Witaj z powrotem! Wznowiono od miejsca, w którym skończyłeś.</p>
                    <p id="welcomeBackSubtext" class="text-xs text-indigo-700/80">Ostatni zapis: przed chwilą</p>
                </div>
            </div>
            <button onclick="dismissWelcomeBanner()" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 px-2.5 py-1 rounded-lg hover:bg-indigo-100 transition cursor-pointer shrink-0">
                Zamknij
            </button>
        </div>

        <!-- STUDY VIEW -->
        <div id="studyView" class="flex-1 flex flex-col justify-between gap-6">
            
            <!-- Live Stats Pill Row -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
                <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Opanowanie</p>
                        <p id="statMasteryPercent" class="text-lg sm:text-xl font-bold text-indigo-600">0%</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm font-bold">★</div>
                </div>

                <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Umiem</p>
                        <p id="statKnownCount" class="text-lg sm:text-xl font-bold text-emerald-600">0 / 40</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">✓</div>
                </div>

                <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Niepewne / Trudne</p>
                        <p id="statHardCount" class="text-lg sm:text-xl font-bold text-amber-600">0</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center text-sm font-bold">!</div>
                </div>

                <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Powtórki w sesji</p>
                        <p id="statSessionCount" class="text-lg sm:text-xl font-bold text-slate-700">0</p>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-sm font-bold">↻</div>
                </div>
            </div>

            <!-- Flashcard Container -->
            <div class="flex-1 flex flex-col items-center justify-center my-2">
                <div class="w-full max-w-2xl perspective-1000">
                    <div id="flashcardInner" onclick="flipCard()" 
                        class="relative w-full min-h-[300px] sm:min-h-[340px] transform-style-3d cursor-pointer select-none">
                        
                        <!-- FRONT FACE -->
                        <div class="absolute inset-0 backface-hidden bg-white rounded-3xl border border-slate-200 shadow-lg hover:shadow-xl transition-shadow p-6 sm:p-10 flex flex-col justify-between">
                            <!-- Card Top Metadata -->
                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span id="cardNumberBadge" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600">#1</span>
                                    <span id="cardOriginBadge" class="hidden text-xs font-semibold px-2.5 py-1 rounded-lg bg-purple-50 text-purple-700 border border-purple-100">Podróże</span>
                                    <span id="cardReasonBadge" class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700">Nowy zwrot</span>
                                </div>
                                <span id="frontLangLabel" class="text-xs font-bold uppercase tracking-wider text-slate-400">Polski</span>
                            </div>

                            <!-- Card Main Sentence -->
                            <div class="my-auto py-4 text-center">
                                <p id="frontText" class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-800 leading-snug">
                                    Ładowanie...
                                </p>
                            </div>

                            <!-- Card Bottom Hint & Audio (if front is EN) -->
                            <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                                <button id="frontSpeakBtn" type="button" onclick="event.stopPropagation(); speakEnglish();" 
                                    class="hidden items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-xl transition">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                    </svg>
                                    Odsłuchaj
                                </button>
                                <span class="text-xs text-slate-400 ml-auto flex items-center gap-1">
                                    Kliknij fiszkę lub naciśnij <kbd class="px-1.5 py-0.5 text-[10px] font-semibold bg-slate-100 border border-slate-300 rounded">Spację</kbd>, aby odwrócić
                                </span>
                            </div>
                        </div>

                        <!-- BACK FACE -->
                        <div class="absolute inset-0 backface-hidden rotate-y-180 bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-900 text-white rounded-3xl border border-indigo-800/50 shadow-xl p-6 sm:p-10 flex flex-col justify-between">
                            <!-- Top Row -->
                            <div class="flex items-center justify-between gap-2">
                                <span id="backLangLabel" class="text-xs font-bold uppercase tracking-wider text-indigo-300">Angielski</span>
                                <button type="button" onclick="event.stopPropagation(); speakEnglish();" 
                                    class="flex items-center gap-1.5 text-xs font-semibold text-white bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-xl transition cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                    </svg>
                                    Wymowa EN
                                </button>
                            </div>

                            <!-- Translation Text -->
                            <div class="my-auto py-4 text-center space-y-3">
                                <p id="backText" class="text-xl sm:text-2xl md:text-3xl font-bold text-white leading-snug">
                                    Loading...
                                </p>
                                <p id="backReferenceText" class="text-xs sm:text-sm text-indigo-200/80 font-normal">
                                    ...
                                </p>
                            </div>

                            <!-- Card Mastery History Footer -->
                            <div class="flex items-center justify-between pt-2 border-t border-white/10 text-xs text-slate-400">
                                <span id="cardHistoryInfo">Próby: 0 | Poziom utrwalenia: 0/5</span>
                                <span>Oceń swoją odpowiedź poniżej ↓</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Action Controls Area -->
            <div class="w-full max-w-2xl mx-auto">
                <!-- Prompt before flip -->
                <div id="revealPromptArea" class="flex justify-center">
                    <button onclick="flipCard()" 
                        class="w-full sm:w-auto min-w-[240px] bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-semibold py-3.5 px-8 rounded-2xl shadow-md shadow-indigo-200 transition cursor-pointer text-base">
                        Pokaż odpowiedź
                    </button>
                </div>

                <!-- 3 Rating Buttons after flip -->
                <div id="ratingButtonsArea" class="hidden grid-cols-1 sm:grid-cols-3 gap-3">
                    <!-- Option 1: Nie umiem -->
                    <button onclick="rateCard('hard')" 
                        class="group flex flex-col items-center justify-center bg-rose-50 hover:bg-rose-600 text-rose-700 hover:text-white border-2 border-rose-200 hover:border-rose-600 p-3.5 rounded-2xl transition-all duration-150 cursor-pointer shadow-sm active:scale-[0.98]">
                        <div class="flex items-center gap-2 font-bold text-base">
                            <span>Nie umiem</span>
                            <kbd class="hidden sm:inline-block text-[10px] px-1.5 py-0.5 rounded bg-rose-100 group-hover:bg-rose-500 text-rose-800 group-hover:text-white border border-rose-300 group-hover:border-rose-400">1</kbd>
                        </div>
                        <span id="hintHard" class="text-[11px] opacity-80 mt-0.5 font-medium">Wróci za ~2 fiszki</span>
                    </button>

                    <!-- Option 2: Nie jestem pewien -->
                    <button onclick="rateCard('unsure')" 
                        class="group flex flex-col items-center justify-center bg-amber-50 hover:bg-amber-500 text-amber-800 hover:text-white border-2 border-amber-200 hover:border-amber-500 p-3.5 rounded-2xl transition-all duration-150 cursor-pointer shadow-sm active:scale-[0.98]">
                        <div class="flex items-center gap-2 font-bold text-base">
                            <span>Nie jestem pewien</span>
                            <kbd class="hidden sm:inline-block text-[10px] px-1.5 py-0.5 rounded bg-amber-100 group-hover:bg-amber-400 text-amber-900 group-hover:text-white border border-amber-300 group-hover:border-amber-300">2</kbd>
                        </div>
                        <span id="hintUnsure" class="text-[11px] opacity-80 mt-0.5 font-medium">Wróci za ~5 fiszek</span>
                    </button>

                    <!-- Option 3: Umiem -->
                    <button onclick="rateCard('known')" 
                        class="group flex flex-col items-center justify-center bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white border-2 border-emerald-200 hover:border-emerald-600 p-3.5 rounded-2xl transition-all duration-150 cursor-pointer shadow-sm active:scale-[0.98]">
                        <div class="flex items-center gap-2 font-bold text-base">
                            <span>Umiem</span>
                            <kbd class="hidden sm:inline-block text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 group-hover:bg-emerald-500 text-emerald-800 group-hover:text-white border border-emerald-300 group-hover:border-emerald-400">3</kbd>
                        </div>
                        <span id="hintKnown" class="text-[11px] opacity-80 mt-0.5 font-medium">Przypomnienie za ~10 fiszek</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- PAUSED SESSION VIEW (Hidden by default) -->
        <div id="pausedView" class="hidden flex-1 flex-col items-center justify-center py-6">
            <div class="w-full max-w-xl bg-white rounded-3xl border border-slate-200 shadow-lg p-6 sm:p-10 text-center space-y-6">
                <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center mx-auto shadow-inner">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>

                <div class="space-y-2">
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-bold">
                        <span>Kategoria:</span>
                        <span id="pausedCategoryName">Podróże i transport</span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900">Nauka wstrzymana — postęp zapisany</h2>
                    <p class="text-sm text-slate-500">
                        Możesz bezpiecznie zamknąć tę kartę, przełączyć kategorię lub wrócić do nauki w dowolnym momencie. Twoja aktualna fiszka (<span id="pausedCardInfo" class="font-semibold text-slate-700">#1</span>) oraz wszystkie priorytety algorytmu w tej kategorii zostały zapamiętane.
                    </p>
                </div>

                <!-- Session Summary Grid -->
                <div class="grid grid-cols-3 gap-3 bg-slate-50 p-4 rounded-2xl border border-slate-200/80">
                    <div>
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">W tej sesji</p>
                        <p id="pausedSessionReviews" class="text-xl font-bold text-slate-800 mt-0.5">0</p>
                    </div>
                    <div class="border-x border-slate-200">
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Opanowanie</p>
                        <p id="pausedMasteryPercent" class="text-xl font-bold text-indigo-600 mt-0.5">0%</p>
                    </div>
                    <div>
                        <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400">Ostatni zapis</p>
